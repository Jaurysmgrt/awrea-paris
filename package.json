{
  "name": "awrea-paris",
  "version": "1.0.0",
  "private": true,
  "description": "AWREA PARIS — maison de prêt-à-porter féminin fait main à Paris. Site e-commerce headless et agents IA de gestion.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "test:e2e": "playwright test",
    "media": "python3 scripts/build-media.py",
    "test:db": "node supabase/tests/rls.test.mjs",
    "legal:todo": "node --experimental-strip-types --no-warnings scripts/legal-todo.ts",
    "eco:constants": "node scripts/eco-constants.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --import ./tests/unit/alias.mjs --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.4.0",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@tgwf/co2": "^0.19.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "hyphen": "^1.10.6",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
