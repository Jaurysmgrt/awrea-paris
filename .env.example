# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement d'Awrea Paris — MODÈLE, sans aucune valeur secrète.
#
# Règle de la maison : toutes les clés (Shopify, Supabase, Claude, e-mails…) vivent
# uniquement dans les variables d'environnement — Vercel (Settings → Environment Variables)
# et GitHub (Settings → Secrets and variables → Actions) — jamais dans le code ni sur GitHub.
# En local : copier ce fichier en `.env.local` (ignoré par git) et le compléter.
# Sans ces clés, le site fonctionne en mode démonstration.
#
# Interrupteurs : chaque service a une variable `<SERVICE>_PROVIDER` (lib/config/providers.ts).
#   - vide : le vrai prestataire dès que ses clés sont renseignées, la simulation sinon ;
#   - `mock` : simulation forcée, même avec les clés (démonstration, tests) ;
#   - nom du prestataire : branché seulement si toutes ses clés sont là, sinon simulation
#     (le site ne plante jamais ; l'Atelier › Réglages indique les clés manquantes).
# Mode d'emploi pas à pas, dans l'ordre : ACTIVATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Adresse canonique (une seule version : l'autre, avec ou sans www, y est redirigée)
NEXT_PUBLIC_SITE_URL=https://www.awreaparis.com
# Google Search Console (balise de vérification)
GOOGLE_SITE_VERIFICATION=

# ── Sécurité (obligatoires en production) ────────────────────────────────────
# Clé de signature des sessions et de chiffrement de la double authentification :
# 64 caractères aléatoires (ex. `openssl rand -base64 48`). Sans elle, l'Atelier reste fermé.
SESSION_SECRET=
# Adresse secrète de l'Atelier (tableau de bord et éditeur), jamais liée depuis le site :
# « /prive- » suivi d'au moins 12 lettres minuscules ou chiffres tirés au hasard
# (ex. `echo /prive-$(openssl rand -hex 8)`). Obligatoire en production ; /gestion en démonstration.
ADMIN_PATH=
# Adresses autorisées à entrer dans l'Atelier, séparées par des virgules (à défaut : ATELIER_EMAIL)
ATELIER_ACCOUNTS=
# Mot de passe d'installation : sert seulement à la première connexion de chaque compte autorisé,
# qui choisit ensuite son mot de passe personnel puis configure sa double authentification
ATELIER_PASSWORD=
# Clé des tâches planifiées (Vercel Cron l'envoie automatiquement) : 32 caractères aléatoires
CRON_SECRET=
# « strict » (par défaut : nonce par page, aucune exécution de script en ligne) ou « static »
CSP_MODE=strict
# Destinataire des alertes de sécurité (connexion inhabituelle à l'Atelier)
SECURITY_ALERT_EMAIL=
# Cloudflare Turnstile (anti-robots des formulaires) — mock | turnstile
CAPTCHA_PROVIDER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Boutique et paiement (Shopify) ───────────────────────────────────────────
# mock | shopify
COMMERCE_PROVIDER=
# Adresse technique de la boutique (ex. awrea-paris.myshopify.com)
SHOPIFY_STORE_DOMAIN=
# Canal « Headless » : jeton PRIVÉ (recommandé, côté serveur) ou, à défaut, jeton public
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Accès Admin des agents — application du Dev Dashboard (jeton de 24 h renouvelé automatiquement) :
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# … ou ancienne application personnalisée (jeton permanent « shpat_ ») :
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Clé de signature des webhooks créés dans Réglages › Notifications (sinon SHOPIFY_CLIENT_SECRET)
SHOPIFY_WEBHOOK_SECRET=
# version de l’API (par défaut 2026-07 ; Shopify en publie une par trimestre)
SHOPIFY_API_VERSION=
# Variante « emballage cadeau » (produit caché dans Shopify)
SHOPIFY_GIFT_WRAP_VARIANT_ID=

# ── Base clientes (Supabase, région Union européenne) ────────────────────────
# mock | supabase
CUSTOMERS_PROVIDER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : côté serveur uniquement, jamais préfixée NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ── Stockage technique (Upstash Redis via Vercel Marketplace) ────────────────
# mock (fichier local .data/store.json) | upstash
STORE_PROVIDER=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Intelligence artificielle (assistante, styliste, agents) ─────────────────
# mock | anthropic
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Modèle (par défaut : le plus capable) et effort de l'assistante (low, medium, high)
ANTHROPIC_MODEL=
AI_ASSISTANT_EFFORT=low

# ── E-mails ──────────────────────────────────────────────────────────────────
# Transactionnels — mock (boîte d'envoi simulée, lisible dans l'Atelier) | resend
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="Awrea Paris <atelier@awreaparis.com>"
# Adresse de l'atelier (copies des demandes, rapports des agents)
ATELIER_EMAIL=
REPORT_EMAIL=
# Lettres et scénarios automatiques — mock (envoi par l'outil transactionnel) | brevo | klaviyo
MARKETING_PROVIDER=
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# ── Mesure d'audience et publicité (chargées seulement après consentement) ───
# Chaque identifiant vide = service éteint.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Microsoft Clarity (cartes de chaleur, consentement « mesure d'audience »)
NEXT_PUBLIC_CLARITY_ID=
# Pixel TikTok (consentement « publicité »)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Livraison et retours ─────────────────────────────────────────────────────
# Suggestions d'adresses à la commande — mock | ign (Géoplateforme de l'IGN, service public gratuit)
ADDRESS_PROVIDER=
# Étiquettes de retour prépayées — mock | colissimo (contrat Colissimo Entreprise)
LABELS_PROVIDER=
COLISSIMO_CONTRACT_NUMBER=
COLISSIMO_PASSWORD=

# ── Comptabilité ─────────────────────────────────────────────────────────────
# Destinataire de l'export comptable mensuel (à défaut : ATELIER_EMAIL)
ACCOUNTING_EMAIL=

# ── Instagram (grille de la page d'accueil) ──────────────────────────────────
# mock (photographies de la Maison) | instagram
INSTAGRAM_PROVIDER=
INSTAGRAM_ACCESS_TOKEN=

# ── Tests (local et intégration continue) ────────────────────────────────────
# E2E_ATELIER_PASSWORD=   mot de passe de l'Atelier pour les tests e2e contre un déploiement
# ATELIER_TOTP_SECRET=    secret TOTP imposé à tous les comptes (tests uniquement)
# E2E_ATELIER_EMAIL=      compte de l'Atelier utilisé par les tests e2e
# AWREA_DEMO_CODES=1      affiche les codes de connexion des clientes (prévisualisation)
